pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Code already checked out'
            }
        }

        stage('Build') {
            steps {
                echo 'Build step running'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application'
            }
        }
    }
}
